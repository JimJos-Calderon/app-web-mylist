# Copia a `.env` y rellena los valores. Vite solo expone variables que empiezan por VITE_.

# — Obligatorias (frontend) —
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# — Opcionales —
# Errores en producción (sin valor, Sentry no se activa)
# VITE_SENTRY_DSN=

# TMDB: póster, título ES, sinopsis (Bearer API v3)
# VITE_TMDB_ACCESS_TOKEN=

# Push en navegador
# VITE_VAPID_PUBLIC_KEY=

# — Playwright E2E (opcional): login automático en tests
# Puedes definirlas aquí o exportarlas en la shell; playwright.config carga prefijo E2E_ desde .env
# E2E_EMAIL=
# E2E_PASSWORD=
